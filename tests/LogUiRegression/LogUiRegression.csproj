<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <HostEditPageSource Condition="'$(HostEditPageSource)' == ''">../../TrojanPlusApp/Views/HostEditPage.xaml.cs</HostEditPageSource>
    <HostsPageSource Condition="'$(HostsPageSource)' == ''">../../TrojanPlusApp/Views/HostsPage.xaml.cs</HostsPageSource>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
    <None Include="../../TrojanPlusApp/Views/HostEditPage.xaml" Link="HostEditPage.xaml" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="$(HostEditPageSource)" Link="HostEditPage.xaml.cs" />
    <Compile Include="$(HostsPageSource)" Link="HostsPage.xaml.cs" />
    <Compile Include="../../TrojanPlusApp/Services/DebugLogFiles.cs" Link="DebugLogFiles.cs" />
    <Compile Include="../../TrojanPlusApp/Services/LogClipboard.cs" Link="LogClipboard.cs" />
    <Compile Include="../../TrojanPlusApp/Services/RollingLog.cs" Link="RollingLog.cs" />
  </ItemGroup>
</Project>
